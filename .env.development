# Entorno de desarrollo local: Vite solo carga este archivo con `npm run dev`.
# No afecta a los builds de release, que usan .env.production.
VITE_APP_NAME="NOA Transportes"
VITE_INITIAL_VIEW="login"
VITE_NODE_ENV="development"

# API local a través del proxy de Vite (vite.config.js -> /api).
VITE_API_PROXY_TARGET="http://api.transportessinbarreras.local"
VITE_API_BASE_URL="/api/v1/"
VITE_API_TIMEOUT=30000

# Feature flags
VITE_FEATURE_AUTH_ENABLED=true
VITE_FEATURE_DASHBOARD_ENABLED=true
VITE_USE_MOCK_DATA=false
