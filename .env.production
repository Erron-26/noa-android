# Configuración general de la aplicación
VITE_APP_NAME="NOA Transportes"
VITE_APP_VERSION="1.1.7"
VITE_INITIAL_VIEW="login"

# Entorno de ejecución
VITE_NODE_ENV="production"

# Configuración del servidor
VITE_HOST="localhost"
VITE_PREVIEW_PORT=4173

# URL del frontend (para CORS)
VITE_FRONTEND_URL="https://apptransportessinbarreras.transportessinbarreras.com"

# Variables de API
VITE_API_PROXY_TARGET="https://api.transportessinbarreras.com"
VITE_API_BASE_URL="https://api.transportessinbarreras.com/api/v1/"
VITE_API_NATIVE_URL="https://api.transportessinbarreras.com/api/v1/"
VITE_API_TIMEOUT=30000

# Variables de autenticación
VITE_AUTH_TOKEN_KEY="auth_token"
VITE_AUTH_REFRESH_TOKEN_KEY="refresh_token"
VITE_AUTH_TOKEN_EXPIRY=7200

# Variables de seguridad
VITE_ENCRYPTION_KEY="sBm9xPQ3MFTqPJCTNW3iP45cGZrZHDEu18"

# Variables de i18n
VITE_I18N_LOCALE="es"
VITE_I18N_FALLBACK_LOCALE="en"

# Variables de UI
VITE_DEFAULT_THEME="light"

# Feature flags
VITE_FEATURE_AUTH_ENABLED=true
VITE_FEATURE_DASHBOARD_ENABLED=true
VITE_FEATURE_ANALYTICS_ENABLED=true
VITE_USE_MOCK_DATA=false

# Build
VITE_MAX_BUNDLE_SIZE=5
